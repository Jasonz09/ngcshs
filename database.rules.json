{
  "rules": {
    "pointsAdmins": {
      ".read": false,
      ".write": false
    },
    "clubPoints": {
      ".read": "auth != null && (auth.token.admin === true || root.child('pointsAdmins').child(auth.uid).val() === true)",
      ".write": "auth != null && (auth.token.admin === true || root.child('pointsAdmins').child(auth.uid).val() === true)",
      "entries": {
        "$entry": {
          ".validate": "(!data.exists() || newData.val() === data.val()) && newData.hasChildren(['memberId', 'year', 'amount', 'reason', 'date', 'actor', 'at', 'type']) && newData.child('amount').isNumber() && newData.child('amount').val() !== 0 && newData.child('reason').isString() && newData.child('memberId').isString() && (data.exists() || newData.child('actor').val() === auth.uid)"
        }
      }
    },
    "contacts": {
      ".read": true,
      ".write": "auth != null"
    },
    "customEvents": {
      ".read": true,
      ".write": "auth != null"
    },
    "customMeetings": {
      ".read": true,
      ".write": "auth != null"
    },
    "customForms": {
      ".read": true,
      ".write": "auth != null"
    },
    "formSubmissions": {
      ".read": true,
      ".write": true
    },
    "picturePosts": {
      ".read": true,
      ".write": "auth != null"
    },
    "officerCategories": {
      ".read": true,
      ".write": "auth != null"
    },
    "officerRoles": {
      ".read": true,
      ".write": "auth != null"
    },
    "faqs": {
      ".read": true,
      ".write": "auth != null"
    },
    "attendanceMemberRoster": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "attendanceScans": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
